{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" session-start.mjs" } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Edit|Write|NotebookEdit|Read|View|Grep|Glob",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" pre-tool-guard.mjs" } ]
      },
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" bash-guard.mjs" } ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" post-tool-scrub.mjs" } ]
      },
      {
        "matcher": "*",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" post-tool-telemetry.mjs" } ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" post-tool-failure.mjs" } ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "harness:el-architect|el-architect",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" el-exit-gate.mjs" } ]
      }
    ]
  }
}
