      "Read(**/.env.e[!x]*)",
      "Read(**/.env.ex[!a]*)",
      "Read(**/.env.t[!e]*)",
      "Read(**/.env.te[!m]*)",
      "Read(**/.env.*.local)",
      "Edit(**/.env*)",
      "Bash(* > .env*)",
      "Bash(* >> .env*)"
    ]
  }
}
