{
  "version": 1,
  "name": "Kaleidoscopic Mandala",
  "tags": ["built-in", "flagship"],
  "transition": { "style": "crossfade", "seconds": 0.32 },
  "feedback": {
    "warpMode": "polarFold",
    "kaleidoN": 8,
    "mandalaPattern": "auto",
    "radialFold": 0.48,
    "mandalaTile": 0.35,
    "mandalaCounterSpin": 0.3,
    "mandalaKickFlare": 0.4,
    "zoom": 1.038,
    "rotate": 0.015,
    "decay": 0.90,
    "fade": 0.005,
    "decayRgb": [0.92, 0.90, 0.96]
  },
  "warp": [
    { "type": "swirl", "params": { "amount": 0.12, "scale": 1, "speed": 0.15 } }
  ],
  "reactions": [
    { "trigger": { "type": "strongBeat" }, "response": "kick", "target": { "group": "feedback", "name": "zoom" }, "amount": 0.08, "ease": 0.3 },
    { "trigger": { "type": "everyNBeats", "n": 16 }, "response": "flip", "target": { "group": "feedback", "name": "rotate" }, "amount": 0, "ease": 0.8 },
    { "trigger": { "type": "section" }, "response": "pick", "target": { "group": "post", "name": "colourMapMix" }, "amount": 0.6, "ease": 2 }
  ],
  "layers": [
    {
      "type": "shape",
      "blend": "add",
      "trails": false,
      "params": {
        "baseShape": "circle",
        "size": 0.5,
        "effectType": "waveform",
        "thickness": 2.2,
        "colorMode": "palette",
        "audioSource": "waveform",
        "symmetry": "wrap",
        "propMode": "single"
      }
    },
    {
      "type": "particles",
      "blend": "add",
      "params": {
        "shape": "streak",
        "swirlGain": 1.2
      }
    },
    {
      "type": "shape",
      "params": {
        "baseShape": "circle",
        "effectType": "solidLine",
        "propMode": "shockwave",
        "propSpeed": 0.875,
        "thickness": 3.0,
        "glow": 0.8,
        "audioSource": "sub",
        "colorMode": "palette"
      }
    }
  ],
  "post": {
    "colourMap": 0.4,
    "colourMapBy": "angle",
    "colourMapGradient": "neon",
    "colourMapGradient2": "sunset",
    "colourMapMix": 0.3
  }
}
