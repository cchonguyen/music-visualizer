{
  "version": 1,
  "name": "Kaleidoscopic Mandala",
  "tags": ["built-in", "flagship"],
  "transition": { "style": "crossfade", "seconds": 0.32 },
  "feedback": {
    "warpMode": "polarFold",
    "kaleidoN": 8,
    "mandalaPattern": "auto",
    "radialFold": 0.48,
    "mandalaTile": 0.35,
    "mandalaCounterSpin": 0.3,
    "mandalaKickFlare": 0.4,
    "zoom": 1.038,
    "rotate": 0.015,
    "decay": 0.90,
    "fade": 0.005,
    "decayRgb": [0.92, 0.90, 0.96]
  },
  "layers": [
    {
      "type": "waveform",
      "blend": "add",
      "trails": false,
      "params": {
        "mode": "circle",
        "radius": 0.5,
        "thickness": 2.2,
        "colorMode": "palette"
      }
    },
    {
      "type": "particles",
      "blend": "add",
      "params": {
        "shape": "streak",
        "swirlGain": 1.2
      }
    },
    {
      "type": "shockwave",
      "params": {
        "style": "ring",
        "ringSec": 0.4
      }
    }
  ],
  "post": {}
}
