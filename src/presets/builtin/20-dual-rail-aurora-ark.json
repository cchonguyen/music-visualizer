{
  "version": 1,
  "name": "Dual-Rail Aurora Ark",
  "tags": ["built-in", "flagship", "shape"],
  "transition": { "style": "crossfade", "seconds": 0.35 },
  "feedback": {
    "zoom": 1.012,
    "decay": 0.94,
    "decayRgb": [0.92, 0.95, 0.98]
  },
  "layers": [
    {
      "type": "spectralTerrain",
      "opacity": 0.35,
      "blend": "screen",
      "params": {
        "elevation": 0.35,
        "width": 1.4,
        "horizonY": 0.25,
        "foregroundY": -0.55,
        "brightness": 0.85,
        "lineThickness": 1.5,
        "ridgeShape": "smooth",
        "layoutMode": "fullHorizon",
        "gridCols": 16,
        "skirtOpacity": 0.15,
        "colorSpread": 0.75,
        "terrainFlow": 0.3
      }
    },
    {
      "type": "shape",
      "params": {
        "baseShape": "edgeLine",
        "edgeMode": "dualHorizontal",
        "effectType": "auroraFill",
        "sampleCount": 64,
        "effectLength": 0.45,
        "extrudeDirection": "outward",
        "audioSource": "spectrum",
        "colorMode": "palette",
        "glow": 0.85
      }
    },
    {
      "type": "shape",
      "params": {
        "baseShape": "arc",
        "arcSweep": 0.65,
        "effectType": "harmonicWave",
        "sampleCount": 64,
        "thickness": 3.0,
        "effectLength": 0.35,
        "audioSource": "mid",
        "colorMode": "frequencyGradient",
        "glow": 0.8
      }
    }
  ],
  "post": {
    "bloom": 0.7
  }
}
