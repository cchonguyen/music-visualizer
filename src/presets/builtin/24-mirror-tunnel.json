{
  "version": 1,
  "name": "Mirror Tunnel",
  "tags": ["built-in", "flagship", "warp"],
  "transition": { "style": "crossfade", "seconds": 0.35 },
  "feedback": { "decay": 0.93 },
  "warp": [
    { "type": "tunnel", "params": { "amount": 0.25, "scale": 1, "speed": 0.5 } },
    { "type": "tile", "params": { "amount": 0.2, "scale": 2 } }
  ],
  "layers": [
    { "type": "particles", "opacity": 0.4, "blend": "add", "params": { "shape": "dot", "brightness": 0.85, "size": 2 } },
    {
      "type": "shape",
      "params": {
        "baseShape": "polygon",
        "sides": 6,
        "effectType": "waveform",
        "sampleCount": 96,
        "effectLength": 0.3,
        "thickness": 2.4,
        "audioSource": "waveform",
        "colorMode": "amplitudeHot",
        "glow": 0.7
      }
    }
  ],
  "post": {
    "bloom": 0.6,
    "bloomThreshold": 0.5,
    "bloomSize": 0.8,
    "colourMap": 0.5,
    "colourMapBy": "angle",
    "colourMapGradient": "neon",
    "colourMapGradient2": "sunset",
    "colourMapMix": 0.3,
    "vignette": 0.6,
    "vignetteShape": "box",
    "vignetteBlend": "add",
    "vignetteGradient": "sunset",
    "vignetteSoftness": 0.5
  }
}
