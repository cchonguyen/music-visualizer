{
  "version": 1,
  "name": "Phyllotaxis Spiral Bloom",
  "tags": ["built-in", "flagship"],
  "transition": { "style": "crossfade", "seconds": 0.35 },
  "feedback": {
    "decay": { "value": 0.86, "link": { "source": "breakdown", "amount": 0.08, "smooth": 0.25, "curve": "swell" } }
  },
  "layers": [
    {
      "type": "particles",
      "blend": "max",
      "params": {
        "mode": "phyllotaxis",
        "seedShape": "petal",
        "phylloPattern": "auto",
        "petalStretch": { "value": 1.75, "link": { "source": "mid", "amount": 0.2, "smooth": 0.15, "curve": "linear" } },
        "flowSpeed": { "value": 1.1, "link": { "source": "bass", "amount": 0.25, "smooth": 0.15, "curve": "swell" } },
        "hueDrift": { "value": 0, "link": { "source": "phrase32", "amount": 0.15, "smooth": 0.25, "mode": "bipolar" } },
        "shape": "dot",
        "size": 2.2,
        "brightness": 1.4
      }
    },
    {
      "type": "shape",
      "opacity": 0.35,
      "opacityLink": { "source": "kickEnv", "amount": 0.25, "smooth": 0.08, "curve": "punch" },
      "blend": "screen",
      "params": {
        "baseShape": "circle",
        "effectType": "pulsingLine",
        "propMode": "concentric",
        "propCount": 4,
        "propSpacing": 0.22,
        "propSpeed": 0.6,
        "propDirection": { "value": "outward", "link": { "source": "drop", "amount": 1, "smooth": 0, "cooldownSec": 10, "enumOptions": ["outward", "inward", "alternating"] } },
        "thickness": 2.0,
        "audioSource": "sub",
        "colorMode": "palette"
      }
    },
    {
      "type": "shape",
      "opacity": 0.45,
      "opacityLink": { "source": "energySlow", "amount": 0.2, "smooth": 0.3, "curve": "swell" },
      "blend": "screen",
      "params": {
        "baseShape": "circle",
        "effectType": "bars",
        "sampleCount": 48,
        "effectLength": 0.35,
        "thickness": 3.0,
        "barGap": 0.25,
        "extrudeDirection": "outward",
        "symmetry": "mirror",
        "normalMode": "radial",
        "propMode": "single",
        "size": 0.45,
        "colorMode": "palette",
        "glow": 0.6
      }
    }
  ],
  "post": {}
}
