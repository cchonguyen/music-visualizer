{
  "version": 1,
  "name": "Solarized Contour Rings",
  "tags": ["built-in", "flagship"],
  "transition": { "style": "crossfade", "seconds": 0.32 },
  "feedback": {
    "sobel": 0.85,
    "solarize": 0.8,
    "decay": 0.96
