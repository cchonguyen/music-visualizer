      "trails": true,
      "params": {
        "texture": true,
        "textureGain": 0.8
      }
    },
    {
      "type": "spectralTerrain",
      "opacity": 1.0,
      "blend": "max",
      "trails": true,
      "params": {
        "elevation": { "value": 0.75, "link": { "source": "bass", "amount": 0.22, "smooth": 0.15, "curve": "swell" } },
