      "opacityLink": { "source": "high", "amount": 0.25, "smooth": 0.15, "curve": "swell" },
      "blend": "screen",
      "trails": false,
      "params": {
        "shape": "dot",
        "swirlGain": 0.8,
        "brightness": 0.9
      }
    }
