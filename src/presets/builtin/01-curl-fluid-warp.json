{
  "version": 1,
  "name": "Curl Fluid Warp",
  "tags": ["built-in", "flagship"],
  "transition": { "style": "crossfade", "seconds": 0.32 },
  "feedback": {
    "warpMode": "curl",
    "warp": { "value": 0.58, "link": { "source": "mid", "amount": 0.35, "smooth": 0.15 } },
    "warpScale": 2.8,
    "warpSpeed": { "value": 0.85, "link": { "source": "bass", "amount": 0.4, "smooth": 0.15 } },
    "curlOctaves": 3,
    "curlTurbulence": 0.55,
    "curlFlowPattern": "plumes",
    "decay": 0.92,
    "decayRgb": [0.95, 0.91, 0.96],
    "hueDrift": 0.018
  },
  "warp": [
    { "type": "flow", "params": { "amount": 0.16, "scale": 1.4, "speed": 0.3 } }
  ],
  "reactions": [
    { "trigger": { "type": "beat" }, "response": "kick", "target": { "group": "feedback", "name": "zoom" }, "amount": 0.06, "ease": 0.4 },
    { "trigger": { "type": "everyNSeconds", "n": 8 }, "response": "drift", "target": { "group": "post", "name": "colourMapMix" }, "amount": 0.5, "ease": 6 }
  ],
  "layers": [
    {
      "type": "shape",
      "params": {
        "baseShape": "circle",
        "size": 0.62,
        "effectType": "waveform",
        "thickness": 2.4,
        "colorMode": "frequencyGradient",
        "effectLength": 0.35,
        "reactivity": { "value": 0.85, "link": { "source": "sub", "amount": 0.35, "smooth": 0.15 } },
        "audioSource": "waveform",
        "symmetry": "wrap",
        "propMode": "single"
      }
    },
    {
      "type": "particles",
      "opacity": 0.55,
      "blend": "add",
      "params": {
        "shape": "dot",
        "size": 1.6,
        "swirlGain": 1.4
      }
    }
  ],
  "post": {
    "colourMap": 0.35,
    "colourMapBy": "distance",
    "colourMapGradient": "aurora",
    "colourMapGradient2": "ocean",
    "colourMapMix": 0.3
  }
}
