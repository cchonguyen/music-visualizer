{
  "version": 1,
  "name": "Corridor Glide",
  "tags": ["built-in", "flagship", "architecture"],
  "theme": "architecture",
  "mood": "driving",
  "transition": { "style": "crossfade", "seconds": 0.5 },
  "feedback": { "decay": 0.86 },
  "layers": [
    {
      "type": "architecture",
      "blend": "add",
      "params": { "mode": "corridor", "speed": 0.9, "gridSize": 1.5, "pillarSpacing": 3, "roomWidth": 2, "roomHeight": 1, "lineWidth": 0.06, "reactivity": 0.6, "fog": 0.8, "horizon": 0, "brightness": 1 }
    },
    {
      "type": "shape",
      "opacity": 0.7,
      "blend": "add",
      "params": {
        "baseShape": "centerLine",
        "size": 0.8,
        "effectType": "waveform",
        "audioSource": "scope",
        "sampleCount": 128,
        "effectLength": 0.25,
        "thickness": 1.8,
        "colorMode": "palette",
        "glow": 0.6
      }
    }
  ],
  "post": {
    "bloom": 0.5,
    "bloomThreshold": 0.5,
    "vignette": 0.5
  }
}
