{
  "version": 1,
  "name": "Neon Weave",
  "tags": ["built-in"],
  "transition": { "style": "crossfade", "seconds": 0.32 },
  "feedback": { "decay": 0.9, "zoom": 1.01 },
  "layers": [
    { "type": "tunnel", "params": { "pattern": "grid", "ringDensity": 0.9, "ringContrast": 0.8, "ringContrastCalm": 0.45, "texture": true, "textureGain": 1.4 } },
    { "type": "particles", "params": { "brightness": 1.3, "hueShift": 0.55, "texture": true, "textureGain": 0.6 } }
  ],
  "post": { "bloom": 1.1, "bloomThreshold": 0.45, "saturation": 1.3 }
}
