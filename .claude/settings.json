{
  "model": "haiku",
  "permissions": {
    "allow": [
      "Bash(node \"$CLAUDE_PROJECT_DIR\"/.harness/*)",
      "Bash(node .harness/*)",
      "Read(**/.env.example)",
      "Read(**/.env.template)",
      "Bash(node bin/update-state.mjs:*)",
      "Bash(bin/verify-slice.sh:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(git push --force-with-lease origin claude/vibe-command-center-v2.2)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/commands/**)",
      "Write(.claude/commands/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.[!et]*)",
      "Read(**/.env.e[!x]*)",
      "Read(**/.env.ex[!a]*)",
      "Read(**/.env.t[!e]*)",
      "Read(**/.env.te[!m]*)",
      "Read(**/.env.*.local)",
      "Edit(**/.env*)",
      "Bash(* > .env*)",
      "Bash(* >> .env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.harness/hooks/session-start.mjs\" || echo 'HARNESS WARNING: Node.js was not found, so the harness guards are OFF this session. Tell the operator: install Node.js 18+ from https://nodejs.org (LTS button), then restart Claude Code.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Edit|Write|NotebookEdit|Read|View|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.harness/hooks/adapter.mjs\" pre-tool-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.harness/hooks/adapter.mjs\" bash-guard.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.harness/hooks/adapter.mjs\" post-tool-scrub.mjs"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.harness/hooks/adapter.mjs\" post-tool-failure.mjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "el-architect",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.harness/hooks/adapter.mjs\" el-exit-gate.mjs"
          }
        ]
      }
    ]
  }
}
