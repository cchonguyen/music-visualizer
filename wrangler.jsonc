{
  // Hybrid Static-Assets + Edge Identity Worker: public routes remain 100% static-first;
  // /admin and /admin/* invoke the Worker to verify Cloudflare Access identity.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-visualizer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*"]
  },
  // Custom domain approved by owner 2026-11-04. Cloudflare creates the DNS record
  // and certificate itself; never hand-create A/CNAME records for this.
  "routes": [{ "pattern": "music-visualizer.charliechonguyen.com", "custom_domain": true }],
  // Keep the workers.dev URL as a backup address.
  "workers_dev": true,
  // Keep dashboard plain variables across deploys (Wrangler defaults to clearing them).
  "keep_vars": true,
  "preview_urls": false
  // Required Worker settings with no default in source. Set them as Cloudflare secrets or variables
  // (Workers & Pages > music-visualizer > Settings > Variables and Secrets). The Worker fails closed
  // with 503 `admin_config_missing` on admin routes while any of the first three is missing:
  //   ADMIN_EMAIL              the one email allowed to use /admin
  //   CF_ACCESS_TEAM_DOMAIN    Access team URL, e.g. https://<team>.cloudflareaccess.com
  //   CF_ACCESS_AUD            Access application audience tag
  //   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY   preset write proxy (secrets)
}
